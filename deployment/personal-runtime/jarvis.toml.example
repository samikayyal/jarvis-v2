[runtime]
model = "gpt-5.6-luna"
allowed_models = ["gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna"]
reasoning_effort = "medium"
allowed_reasoning_efforts = ["none", "minimal", "low", "medium", "high", "xhigh", "max"]
inactivity_minutes = 60
max_context_tokens = 100000
request_timeout_seconds = 600
max_tool_rounds = 8
command_timeout_seconds = 300
max_output_chars = 65536

# Replace this placeholder with the exact IPv4 gateway of OpenWA's Docker bridge.
# The active service must bind only this private address, never a wildcard, LAN,
# Tailscale, public, hostname, loopback, or IPv6 address.
listener_host = "REPLACE_WITH_DOCKER_BRIDGE_GATEWAY"
listener_port = 9011

message_cache_path = "data/message-cache.json"
message_cache_retention_days = 7
trace_path = "data/runtime-trace.jsonl"
trace_max_bytes = 10485760
system_prompt_path = "SYSTEM.md"

openwa_api_base_url = "REPLACE_WITH_PRIVATE_OPENWA_API_BASE_URL"
openwa_internal_session_id = "replace-with-internal-session-id"
openwa_named_session = "replace-with-named-session"
openwa_authorized_operator_number = "replace-with-number@c.us"
openwa_operator_chat_id = "replace-with-chat-id@c.us"

ubuntu_working_directory = "/srv/jarvis-workspace"
ubuntu_read_only_prefixes = ["pwd", "git status"]

# Add vault_path only after reviewing its exact read-only filesystem path, for
# example: vault_path = "/srv/knowledge-vault"
#
# Configure all four Windows SSH values together if Windows execution is enabled:
# windows_ssh_host = "REPLACE_WITH_TAILSCALE_HOST"
# windows_ssh_user = "REPLACE_WITH_WINDOWS_USER"
# windows_ssh_identity_file = "/var/lib/jarvis-personal-runtime/ssh/id_ed25519"
# windows_working_directory = "D:\\Projects\\Jarvis-v2"
# The service account's known_hosts file must already pin the exact SSH host key.
windows_read_only_prefixes = []

[[mcp_services]]
id = "google-gmail"
endpoint = "https://gmailmcp.googleapis.com/mcp/v1"
manifest_path = "manifests/google-gmail.json"
max_output_chars = 20000

[[mcp_services]]
id = "google-drive"
endpoint = "https://drivemcp.googleapis.com/mcp/v1"
manifest_path = "manifests/google-drive.json"
max_output_chars = 20000

[[mcp_services]]
id = "google-calendar"
endpoint = "https://calendarmcp.googleapis.com/mcp/v1"
manifest_path = "manifests/google-calendar.json"
max_output_chars = 20000

[saved_permissions]
rules = []
