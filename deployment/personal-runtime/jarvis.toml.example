[runtime]
model = "gpt-5.6-luna"
allowed_models = ["gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna"]
reasoning_effort = "medium"
allowed_reasoning_efforts = ["none", "minimal", "low", "medium", "high", "xhigh", "max"]
inactivity_minutes = 60
max_context_tokens = 100000
request_timeout_seconds = 600
max_tool_rounds = 8
command_timeout_seconds = 300
max_output_chars = 65536

# Replace this example with the exact IPv4 gateway of OpenWA's Docker bridge.
# The loader rejects wildcard, loopback, public, hostname, and IPv6 listeners.
listener_host = "172.17.0.1"
listener_port = 8787

message_cache_path = "data/message-cache.json"
message_cache_retention_days = 7
trace_path = "data/runtime-trace.jsonl"
trace_max_bytes = 10485760
system_prompt_path = "SYSTEM.md"

openwa_api_base_url = "http://172.17.0.2:2785/api"
openwa_internal_session_id = "replace-with-internal-session-id"
openwa_named_session = "replace-with-named-session"
openwa_authorized_operator_number = "replace-with-number@c.us"
openwa_operator_chat_id = "replace-with-chat-id@c.us"

ubuntu_working_directory = "."
ubuntu_read_only_prefixes = ["pwd", "git status"]

# Add vault_path only after reviewing its exact read-only filesystem path.
# Configure all four Windows SSH values together if Windows execution is enabled.
windows_read_only_prefixes = []

[saved_permissions]
rules = []
