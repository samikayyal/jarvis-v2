[Unit]
Description=Jarvis personal assistant runtime
Documentation=file:@RELEASE_ROOT@/current/deployment/personal-runtime/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
UMask=0077
WorkingDirectory=@RUNTIME_ROOT@
ExecStartPre=@RELEASE_ROOT@/current/.venv/bin/jarvis-personal-runtime --root @RUNTIME_ROOT@ --config /etc/jarvis/jarvis.toml --check
ExecStart=@RELEASE_ROOT@/current/.venv/bin/jarvis-personal-runtime --root @RUNTIME_ROOT@ --config /etc/jarvis/jarvis.toml
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis-personal-runtime
Environment=PYTHONUNBUFFERED=1

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=full
ReadWritePaths=@RUNTIME_ROOT@ /etc/jarvis/personal-runtime
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
TasksMax=64

[Install]
WantedBy=multi-user.target
