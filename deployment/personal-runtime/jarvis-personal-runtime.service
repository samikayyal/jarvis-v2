[Unit]
Description=Jarvis personal assistant runtime
Documentation=file:@RELEASE_ROOT@/current/deployment/personal-runtime/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
UMask=0077
WorkingDirectory=@RUNTIME_ROOT@
ExecStartPre=@RELEASE_ROOT@/current/.venv/bin/jarvis-personal-runtime --root @RUNTIME_ROOT@ --config /etc/jarvis/jarvis.toml --check
ExecStart=@RELEASE_ROOT@/current/.venv/bin/jarvis-personal-runtime --root @RUNTIME_ROOT@ --config /etc/jarvis/jarvis.toml
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis-personal-runtime
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
