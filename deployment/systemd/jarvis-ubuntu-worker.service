[Unit]
Description=Jarvis native Ubuntu worker
After=user@10008.service
Wants=user@10008.service

[Service]
Type=simple
User=jarvis-worker
Group=jarvis-worker
UMask=0077
RuntimeDirectory=jarvis-worker
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/user/10008
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/10008/bus
Environment=PYTHONPATH=/opt/jarvis/current/src
WorkingDirectory=/opt/jarvis/current
ExecStart=/opt/jarvis/current/.venv/bin/python -m jarvis_control_plane.native_worker_runtime ubuntu --config /etc/jarvis/native/ubuntu-worker.json
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/run/jarvis-worker
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
TasksMax=64

[Install]
WantedBy=multi-user.target
