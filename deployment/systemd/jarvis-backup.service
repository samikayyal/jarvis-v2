[Unit]
Description=Create the nightly Jarvis administrative backup

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/opt/jarvis/current
Environment=PYTHONPATH=/opt/jarvis/current/src
ExecStart=/opt/jarvis/current/.venv/bin/python -m jarvis_control_plane.administrative_backup create --kind nightly --artifact-lock /opt/jarvis/current/deployment/artifacts.lock.json
